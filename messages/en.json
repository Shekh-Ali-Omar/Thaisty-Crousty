  "faq": {
    "title": "Frequently Asked Questions.",
    "supportTag": "Support",
    "questions": [
      {
        "q": "Where is Thaisty Crousty located?",
        "a": "We are situated in the heart of Dely Ibrahim, Algiers. Our exact address is Rue 11 Decembre 1960. You can find an interactive map on our Location page."
      },
      {
        "q": "What are your opening hours?",
        "a": "We are open daily from 11:00 AM to 11:00 PM. On weekends, we often stay open until midnight to satisfy your late-night cravings."
      },
      {
        "q": "How can I place an order?",
        "a": "You can browse our menu, add items to your cart, and checkout right here on our website. The final order is sent via WhatsApp to our kitchen for immediate preparation."
      },
      {
        "q": "Do you offer delivery?",
        "a": "Yes, we offer fast delivery within Dely Ibrahim and surrounding areas including Cheraga and Ouled Fayet. Delivery is typically free for orders above a certain amount."
      },
      {
        "q": "Are your ingredients fresh?",
        "a": "Absolutely. We pride ourselves on using 100% fresh, locally sourced ingredients. Our meat is prepared daily, and our vegetables are delivered every morning."
      },
      {
        "q": "Do you have vegetarian options?",
        "a": "Yes! While we are famous for our 'Crousty' meats, we have a selection of delicious desserts and can customize some items to be vegetarian-friendly. Look for the 'Sweet' category in our menu."
      }
    ],
    "more": {
      "title": "Still have questions?",
      "desc": "Can't find the answer you're looking for? Reach out to our friendly team on WhatsApp.",
      "button": "Contact Support"
    }
